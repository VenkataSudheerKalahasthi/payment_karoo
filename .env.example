# ==============================================================================
# TRUSTPAY ENTERPRISE v2.0 - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env in local development. Never commit sensitive keys.

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=5000
API_HOST=localhost

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL + Prisma 7)
# ------------------------------------------------------------------------------
# Session Pooler (IPv4 / Default, Port 5432):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Direct Connection (IPv6 networks, Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# Frontend Application URLs
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SUPERADMIN_URL=http://localhost:3002

# ------------------------------------------------------------------------------
# Security & CORS Configuration
# Comma-separated list of allowed origins for Express CORS middleware
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ------------------------------------------------------------------------------
# Client Frontend API Target (Vite apps)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# Clerk Authentication SDK Configuration
# ------------------------------------------------------------------------------
# Frontend Clerk Publishable Key (exposed in client applications)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Backend Clerk Secret Key (strictly confidential, backend only)
CLERK_SECRET_KEY=sk_test_placeholder_key
