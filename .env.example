# ==============================================================================
# TRUSTPAY ENTERPRISE v2.0 — ROOT ENVIRONMENT TEMPLATE
# ==============================================================================

# Node Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Server Port (Supported via PORT or API_PORT)
PORT=5000
API_PORT=5000
API_HOST=0.0.0.0

# Database Connectivity (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Application URLs
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SUPERADMIN_URL=http://localhost:3002

# Allowed CORS Origins (Comma-separated public origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Frontend Public API URL (Consumed by Vite frontends)
VITE_API_URL=http://localhost:5000/api/v1

# Clerk Authentication Keys
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Storage & Evidence Access (Optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_SIGNING_SECRET=

# ==============================================================================
# FINANCIAL SAFETY INVARIANTS (MANDATORY NON-CUSTODIAL GUARDS)
# ==============================================================================
PAYMENTS_LIVE_ENABLED=false
ESCROW_LIVE_MOVEMENT_ENABLED=false
PAYOUTS_ENABLED=false

# Cashfree Payment Gateway (DEFERRED IN PHASE 8 — Non-live, unconfigured)
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=
CASHFREE_RETURN_URL=http://localhost:3000/payments/callback?order_id={order_id}
CASHFREE_WEBHOOK_URL=http://localhost:5000/api/v1/webhooks/cashfree
