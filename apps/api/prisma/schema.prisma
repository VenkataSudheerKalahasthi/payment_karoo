// Prisma Schema for TrustPay Enterprise v2.0
// Database Engine: PostgreSQL (Prisma 7 with PostgreSQL Driver Adapter)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// 1. ENUMS
// ==============================================================================

enum UserRole {
  CLIENT
  WORKER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkerAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ContractStatus {
  DRAFT
  PENDING_ACCEPTANCE
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  IN_REVISION
  APPROVED
  CANCELLED
  DISPUTED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum RevisionStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum NotificationType {
  CONTRACT_UPDATE
  MILESTONE_SUBMITTED
  REVISION_REQUESTED
  MESSAGE_RECEIVED
  SYSTEM_ALERT
  HIRING_REQUEST_RECEIVED
  HIRING_REQUEST_ACCEPTED
  HIRING_REQUEST_DECLINED
  HIRING_REQUEST_NEGOTIATION
  CONTRACT_ACCEPTED
  DISPUTE_RAISED
  DISPUTE_RESPONSE_SUBMITTED
  DISPUTE_EVIDENCE_UPLOADED
  DISPUTE_RESOLUTION_PROPOSED
  DISPUTE_RESOLVED
  AMENDMENT_PROPOSED
  AMENDMENT_ACCEPTED
  AMENDMENT_REJECTED
  TERMINATION_REQUESTED
  TERMINATION_ACCEPTED
  TERMINATION_REJECTED
}

enum DisputeCategory {
  QUALITY_OF_WORK
  MISSED_DEADLINE
  SCOPE_DISPUTE
  UNRESPONSIVE_PARTY
  UNAUTHORIZED_MODIFICATION
  PAYMENT_ISSUE
  BREACH_OF_TERMS
  OTHER
}

enum DisputeStatus {
  OPEN
  EVIDENCE_REQUESTED
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  RESPONSE_REQUIRED
  MEDIATION
  RESOLUTION_PROPOSED
  RESOLUTION_ACCEPTED
  RESOLUTION_REJECTED
  ESCALATED
  RESOLVED
  CLOSED
  WITHDRAWN
}

enum DisputeResolutionType {
  FULL_REFUND_TO_CLIENT
  FULL_RELEASE_TO_WORKER
  SPLIT_SETTLEMENT
  CANCEL_CONTRACT
  DISMISS_DISPUTE
}

enum DisputeResolutionStatus {
  PROPOSED
  ACCEPTED_BY_PARTIES
  REJECTED_BY_PARTY
  ENFORCED_BY_ADMIN
  SUPERSEDED
}

enum AmendmentStatus {
  DRAFT
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum TerminationStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  RESOLVED
}

enum EscrowOperationalState {
  PAYMENT_VERIFIED_SANDBOX
  ALLOCATED
  WORK_IN_PROGRESS
  MILESTONE_SUBMITTED
  MILESTONE_UNDER_REVIEW
  MILESTONE_APPROVED
  REVISION_REQUESTED
  DISPUTED
  ON_HOLD
  RELEASE_ELIGIBLE
  COMPLETED
  TERMINATED
}

enum HiringRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  NEGOTIATION
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerTransactionType {
  ESCROW_DEPOSIT
  ESCROW_RELEASE
  ESCROW_REFUND
  PLATFORM_FEE
  ADJUSTMENT
  REVERSAL
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum EscrowStatus {
  NOT_INITIALIZED
  PENDING_FUNDING
  FUNDING_PROCESSING
  FUNDED
  PARTIALLY_ALLOCATED
  RELEASE_PENDING
  PARTIALLY_RELEASED
  RELEASED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  FAILED
  CANCELLED
}

enum PaymentTransactionType {
  ESCROW_FUNDING
  MILESTONE_RELEASE
  REFUND
  PLATFORM_FEE
}

enum PaymentTransactionStatus {
  INITIATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

// ==============================================================================
// 2. IDENTITY FOUNDATION
// ==============================================================================

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model User {
  id        String     @id @default(uuid())
  clerkId   String     @unique
  email     String     @unique
  firstName String?
  lastName  String?
  avatarUrl String?
  roleId    String
  role      Role       @relation(fields: [roleId], references: [id])
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relationships
  profile                  UserProfile?
  workerProfile            WorkerProfile?
  clientContracts          Contract[]                @relation("ClientContracts")
  workerContracts          Contract[]                @relation("WorkerContracts")
  clientHiringRequests     HiringRequest[]           @relation("ClientHiringRequests")
  workerHiringRequests     HiringRequest[]           @relation("WorkerHiringRequests")
  workerShortlists         WorkerShortlist[]         @relation("ClientShortlists")
  contractAcceptances      ContractAcceptance[]
  submissions              MilestoneSubmission[]
  revisionRequests         RevisionRequest[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  adminActivities          AdminActivity[]           @relation("AdminUser")
  ledgerAccounts           LedgerAccount[]
  payerTransactions        PaymentTransaction[]      @relation("PayerTransactions")
  payeeTransactions        PaymentTransaction[]      @relation("PayeeTransactions")
  financialConfigs         PlatformFinancialConfig[]
  initiatedDisputes        Dispute[]                 @relation("InitiatedDisputes")
  respondentDisputes       Dispute[]                 @relation("RespondentDisputes")
  disputeResponses         DisputeResponse[]
  disputeEvidence          DisputeEvidence[]
  proposedResolutions      DisputeResolution[]       @relation("ProposedResolutions")
  disputeNotes             DisputeInternalNote[]
  proposedAmendments       ContractAmendment[]       @relation("ProposedAmendments")
  initiatedTerminations    ContractTerminationRequest[] @relation("InitiatedTerminations")
  createdContractVersions  ContractVersion[]            @relation("CreatedContractVersions")
  escrowActivities         EscrowActivity[]
  clientProjects           Project[]                    @relation("ClientProjects")
  workerProjects           Project[]                    @relation("WorkerProjects")
  milestoneActivities      MilestoneActivity[]
  clientStamps             ClientStamp[]

  @@index([clerkId])
  @@index([email])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  phoneNumber String?
  companyName String?
  timezone    String?  @default("UTC")
  avatarUrl   String?
  address     String?
  country     String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_profiles")
}

// ==============================================================================
// 3. WORKER DOMAIN
// ==============================================================================

model WorkerProfile {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  headline                String?
  hourlyRate              Decimal?           @db.Decimal(10, 2)
  availability            WorkerAvailability @default(AVAILABLE)
  totalCompletedContracts Int                @default(0)
  rating                  Decimal            @default(0.0) @db.Decimal(3, 2)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                  WorkerSkill[]
  portfolioItems          PortfolioItem[]
  shortlistedBy           WorkerShortlist[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([userId])
  @@index([availability])
  @@map("worker_profiles")
}

model Skill {
  id           String        @id @default(uuid())
  name         String        @unique
  category     String?
  workerSkills WorkerSkill[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@map("skills")
}

model WorkerSkill {
  id                String        @id @default(uuid())
  workerProfileId   String
  skillId           String
  yearsOfExperience Int           @default(0)
  workerProfile     WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skill             Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@unique([workerProfileId, skillId])
  @@index([workerProfileId])
  @@index([skillId])
  @@map("worker_skills")
}

model PortfolioItem {
  id              String        @id @default(uuid())
  workerProfileId String
  title           String
  description     String
  projectUrl      String?
  attachmentUrl   String?
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workerProfileId])
  @@map("portfolio_items")
}

// ==============================================================================
// 4. CONTRACT FOUNDATION
// ==============================================================================

model Contract {
  id                 String               @id @default(uuid())
  contractNumber     String               @unique
  title              String
  description        String
  clientId           String
  workerId           String
  status             ContractStatus       @default(DRAFT)
  version            Int                  @default(1)
  totalAmount        Decimal              @db.Decimal(12, 2)
  currency           String               @default("USD")
  scopeOfWork        String?
  termsAndConditions String?
  cancellationTerms  String?
  revisionTerms      String?
  documentHash       String?
  startDate          DateTime?
  endDate            DateTime?
  client             User                 @relation("ClientContracts", fields: [clientId], references: [id])
  worker             User                 @relation("WorkerContracts", fields: [workerId], references: [id])
  milestones         ContractMilestone[]
  conversations      Conversation[]
  acceptances        ContractAcceptance[]
  hiringRequests     HiringRequest[]
  escrowRecord       EscrowRecord?
  paymentTransactions PaymentTransaction[]
  disputes           Dispute[]
  amendments         ContractAmendment[]
  terminationRequests ContractTerminationRequest[]
  versions           ContractVersion[]
  project            Project?
  milestoneActivities MilestoneActivity[]
  clientStamps       ClientStamp[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([contractNumber])
  @@index([clientId])
  @@index([workerId])
  @@index([status])
  @@map("contracts")
}

model ContractMilestone {
  id               String                     @id @default(uuid())
  contractId       String
  projectId        String?
  title            String
  description      String
  amount           Decimal                    @db.Decimal(12, 2)
  order            Int                        @default(1)
  status           MilestoneStatus            @default(PENDING)
  dueDate          DateTime?
  contract         Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  project          Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  submissions      MilestoneSubmission[]
  escrowAllocation EscrowMilestoneAllocation?
  disputes         Dispute[]
  activities       MilestoneActivity[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([contractId])
  @@index([projectId])
  @@index([status])
  @@map("contract_milestones")
}

model Project {
  id                     String              @id @default(uuid())
  contractId             String              @unique
  clientId               String
  workerId               String
  title                  String
  description            String
  scope                  String?
  startDate              DateTime?
  expectedCompletionDate DateTime?
  status                 ProjectStatus       @default(ACTIVE)
  progressPercentage     Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  contract               Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client                 User                @relation("ClientProjects", fields: [clientId], references: [id])
  worker                 User                @relation("WorkerProjects", fields: [workerId], references: [id])
  milestones             ContractMilestone[]
  activities             MilestoneActivity[]

  @@index([contractId])
  @@index([clientId])
  @@index([workerId])
  @@index([status])
  @@map("projects")
}

model MilestoneActivity {
  id            String             @id @default(uuid())
  contractId    String
  projectId     String?
  milestoneId   String?
  actorId       String
  actorRole     UserRole
  action        String
  previousState String?
  newState      String?
  version       Int?               @default(1)
  metadata      Json?
  requestId     String?
  createdAt     DateTime           @default(now())

  contract      Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone     ContractMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  actor         User               @relation(fields: [actorId], references: [id])

  @@index([contractId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([actorId])
  @@index([createdAt])
  @@map("milestone_activities")
}

model MilestoneSubmission {
  id               String            @id @default(uuid())
  milestoneId      String
  workerId         String
  notes            String
  attachmentUrls   String[]          @default([])
  status           SubmissionStatus  @default(SUBMITTED)
  submittedAt      DateTime          @default(now())
  milestone        ContractMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  worker           User              @relation(fields: [workerId], references: [id])
  revisionRequests RevisionRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([milestoneId])
  @@index([workerId])
  @@index([status])
  @@map("milestone_submissions")
}

model RevisionRequest {
  id            String              @id @default(uuid())
  submissionId  String
  requestedById String
  reason        String
  status        RevisionStatus      @default(OPEN)
  submission    MilestoneSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedBy   User                @relation(fields: [requestedById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([submissionId])
  @@index([requestedById])
  @@index([status])
  @@map("revision_requests")
}

// ==============================================================================
// 5. HIRING & MARKETPLACE WORKFLOWS
// ==============================================================================

model HiringRequest {
  id                     String              @id @default(uuid())
  clientId               String
  workerId               String
  title                  String
  description            String
  proposedBudget         Decimal             @db.Decimal(12, 2)
  currency               String              @default("USD")
  requiredSkills         String[]            @default([])
  proposedStartDate      DateTime?
  expectedCompletionDate DateTime?
  status                 HiringRequestStatus @default(PENDING)
  clientMessage          String?
  workerResponse         String?
  contractId             String?
  respondedAt            DateTime?
  client                 User                @relation("ClientHiringRequests", fields: [clientId], references: [id], onDelete: Cascade)
  worker                 User                @relation("WorkerHiringRequests", fields: [workerId], references: [id], onDelete: Cascade)
  contract               Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([clientId])
  @@index([workerId])
  @@index([status])
  @@index([contractId])
  @@map("hiring_requests")
}

model WorkerShortlist {
  id              String        @id @default(uuid())
  clientId        String
  workerProfileId String
  notes           String?
  client          User          @relation("ClientShortlists", fields: [clientId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([clientId, workerProfileId])
  @@index([clientId])
  @@index([workerProfileId])
  @@map("worker_shortlists")
}

model ContractAcceptance {
  id               String   @id @default(uuid())
  contractId       String
  userId           String
  version          Int      @default(1)
  role             UserRole
  acceptanceMethod String   @default("DIGITAL_CONFIRMATION")
  ipAddress        String?
  userAgent        String?
  documentHash     String?
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedAt       DateTime @default(now())

  @@unique([contractId, userId, version])
  @@index([contractId])
  @@index([userId])
  @@index([version])
  @@map("contract_acceptances")
}

model ContractVersion {
  id                        String         @id @default(uuid())
  contractId                String
  version                   Int
  title                     String
  description               String
  totalAmount               Decimal        @db.Decimal(12, 2)
  currency                  String         @default("USD")
  scopeOfWork               String?
  termsAndConditions        String?
  cancellationTerms         String?
  revisionTerms             String?
  documentHash              String
  milestonesSnapshot        Json
  versionReason             String         @default("INITIAL_CONTRACT")
  createdById               String?
  contractStatusAtCreation  ContractStatus @default(PENDING_ACCEPTANCE)
  isAccepted                Boolean        @default(false)
  createdAt                 DateTime       @default(now())

  contract                  Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy                 User?          @relation("CreatedContractVersions", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([contractId, version])
  @@index([contractId])
  @@index([version])
  @@map("contract_versions")
}

model ClientStamp {
  id                     String    @id @default(uuid())
  contractId             String
  clientId               String
  profileNameSnapshot    String
  verifiedMobileSnapshot String
  appliedAt              DateTime  @default(now())
  pdfVersion             Int       @default(1)
  stampPosition          String    @default("BOTTOM_RIGHT")
  stampAssetPath         String?
  documentHash           String?
  status                 String    @default("APPLIED")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  contract               Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client                 User      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([contractId, pdfVersion])
  @@index([contractId])
  @@index([clientId])
  @@map("client_stamps")
}

// ==============================================================================
// 6. COMMUNICATION
// ==============================================================================

model Conversation {
  id           String                    @id @default(uuid())
  title        String?
  contractId   String?
  contract     Contract?                 @relation(fields: [contractId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([contractId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachments    String[]     @default([])
  isRead         Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  metadata    Json?
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([recipientId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

// ==============================================================================
// 6. GOVERNANCE & AUDIT
// ==============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminActivity {
  id               String   @id @default(uuid())
  adminId          String
  action           String
  targetUserId     String?
  targetResourceId String?
  details          Json?
  admin            User     @relation("AdminUser", fields: [adminId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_activities")
}

// ==============================================================================
// 7. SYSTEM FOUNDATION (Phase 1 Preserved)
// ==============================================================================

model SystemHealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
  status    String
  service   String   @default("TrustPay API")

  @@map("system_health_checks")
}

// ==============================================================================
// 8. DOUBLE-ENTRY ACCOUNTING LEDGER (Phase 4 Foundation)
// ==============================================================================

model LedgerAccount {
  id          String              @id @default(uuid())
  accountCode String              @unique
  accountName String
  accountType LedgerAccountType
  currency    String              @default("USD")
  ownerUserId String?
  status      LedgerAccountStatus @default(ACTIVE)
  ownerUser   User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  entries     LedgerEntry[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([accountCode])
  @@index([accountType])
  @@index([ownerUserId])
  @@index([currency])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id                   String                  @id @default(uuid())
  transactionReference String                  @unique
  transactionType      LedgerTransactionType
  status               LedgerTransactionStatus @default(PENDING)
  currency             String                  @default("USD")
  description          String
  sourceType           String
  sourceId             String?
  idempotencyKey       String                  @unique
  metadata             Json?
  postedAt             DateTime?
  entries              LedgerEntry[]
  createdAt            DateTime                @default(now())

  @@index([transactionReference])
  @@index([transactionType])
  @@index([status])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String            @id @default(uuid())
  ledgerTransactionId String
  ledgerAccountId     String
  entryType           LedgerEntryType
  amountMinor         BigInt
  currency            String            @default("USD")
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)
  ledgerAccount       LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())

  @@index([ledgerTransactionId])
  @@index([ledgerAccountId])
  @@index([entryType])
  @@map("ledger_entries")
}

// ==============================================================================
// 9. ESCROW DOMAIN & ALLOCATIONS (Phase 4 Foundation)
// ==============================================================================

model EscrowRecord {
  id                        String                      @id @default(uuid())
  contractId                String                      @unique
  status                    EscrowStatus                @default(NOT_INITIALIZED)
  currency                  String                      @default("USD")
  contractualAmountMinor    BigInt
  expectedFundedAmountMinor BigInt
  fundedAmountMinor         BigInt                      @default(0)
  allocatedAmountMinor      BigInt                      @default(0)
  releasedAmountMinor       BigInt                      @default(0)
  refundedAmountMinor       BigInt                      @default(0)
  disputeHold               Boolean                     @default(false)
  operationalState          EscrowOperationalState      @default(PAYMENT_VERIFIED_SANDBOX)
  contract                  Contract                    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  paymentTransactions       PaymentTransaction[]
  milestoneAllocations      EscrowMilestoneAllocation[]
  activities                EscrowActivity[]
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  @@index([contractId])
  @@index([status])
  @@map("escrow_records")
}

model EscrowMilestoneAllocation {
  id                   String            @id @default(uuid())
  escrowRecordId       String
  milestoneId          String            @unique
  allocatedAmountMinor BigInt
  releasedAmountMinor  BigInt            @default(0)
  refundedAmountMinor  BigInt            @default(0)
  isReleased           Boolean           @default(false)
  releasedAt           DateTime?
  escrowRecord         EscrowRecord      @relation(fields: [escrowRecordId], references: [id], onDelete: Cascade)
  milestone            ContractMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([escrowRecordId])
  @@index([milestoneId])
  @@map("escrow_milestone_allocations")
}

// ==============================================================================
// 10. PAYMENT TRANSACTIONS & WEBHOOK AUDIT (Phase 4 Foundation)
// ==============================================================================

model PaymentTransaction {
  id                    String                   @id @default(uuid())
  transactionReference  String                   @unique
  escrowRecordId        String?
  contractId            String
  payerId               String
  payeeId               String?
  type                  PaymentTransactionType
  status                PaymentTransactionStatus @default(INITIATED)
  amountMinor           BigInt
  currency              String                   @default("USD")
  provider              String?                  @default("PENDING_SELECTION")
  providerTransactionId String?
  providerOrderId       String?
  failureReason         String?
  idempotencyKey        String                   @unique
  metadata              Json?
  escrowRecord          EscrowRecord?            @relation(fields: [escrowRecordId], references: [id], onDelete: SetNull)
  contract              Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payer                 User                     @relation("PayerTransactions", fields: [payerId], references: [id])
  payee                 User?                    @relation("PayeeTransactions", fields: [payeeId], references: [id])
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([contractId])
  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("payment_transactions")
}

model WebhookEvent {
  id           String             @id @default(uuid())
  provider     String
  eventId      String
  eventType    String
  status       WebhookEventStatus @default(PENDING)
  payload      Json
  signature    String?
  processedAt  DateTime?
  errorMessage String?
  retryCount   Int                @default(0)
  createdAt    DateTime           @default(now())

  @@unique([provider, eventId])
  @@index([provider])
  @@index([status])
  @@map("webhook_events")
}

// ==============================================================================
// 11. PLATFORM FINANCIAL GOVERNANCE (Phase 4 Foundation)
// ==============================================================================

model PlatformFinancialConfig {
  id                     String   @id @default(uuid())
  platformFeePercentage  Decimal  @default(5.00) @db.Decimal(5, 2)
  fixedFeeMinor          BigInt   @default(0)
  supportedCurrencies    String[] @default(["USD", "EUR", "GBP"])
  activeProvider         String   @default("PENDING_SELECTION")
  isLiveMoneyDisabled    Boolean  @default(true)
  updatedByUserId        String?
  updatedByUser          User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("platform_financial_configs")
}


// ==============================================================================
// 12. ADVANCED ESCROW ACTIVITIES, DISPUTES & CONTRACT LIFECYCLE (Phase 6)
// ==============================================================================

model Dispute {
  id                 String              @id @default(uuid())
  disputeNumber      String              @unique
  contractId         String
  milestoneId        String?
  initiatorId        String
  respondentId       String
  category           DisputeCategory
  status             DisputeStatus       @default(OPEN)
  title              String
  description        String
  claimedAmountMinor BigInt?
  disputeHoldActive  Boolean             @default(true)
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  contract           Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone          ContractMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  initiator          User                @relation("InitiatedDisputes", fields: [initiatorId], references: [id])
  respondent         User                @relation("RespondentDisputes", fields: [respondentId], references: [id])
  responses          DisputeResponse[]
  evidence           DisputeEvidence[]
  resolutions        DisputeResolution[]
  internalNotes      DisputeInternalNote[]

  @@index([contractId])
  @@index([milestoneId])
  @@index([initiatorId])
  @@index([respondentId])
  @@index([status])
  @@index([category])
  @@map("disputes")
}

model DisputeResponse {
  id        String   @id @default(uuid())
  disputeId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([disputeId])
  @@index([authorId])
  @@map("dispute_responses")
}

model DisputeEvidence {
  id           String   @id @default(uuid())
  disputeId    String
  uploadedById String
  fileName     String
  fileKey      String
  fileUrl      String
  mimeType     String?
  fileSize     BigInt?
  description  String?
  createdAt    DateTime @default(now())

  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([disputeId])
  @@index([uploadedById])
  @@map("dispute_evidence")
}

model DisputeResolution {
  id                String                  @id @default(uuid())
  disputeId         String
  proposedById      String
  resolutionType    DisputeResolutionType
  status            DisputeResolutionStatus @default(PROPOSED)
  clientAmountMinor BigInt                  @default(0)
  workerAmountMinor BigInt                  @default(0)
  rationale         String
  clientAgreed      Boolean?
  clientAgreedAt    DateTime?
  workerAgreed      Boolean?
  workerAgreedAt    DateTime?
  enforcedByAdminId String?
  enforcedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  dispute           Dispute                 @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  proposedBy        User                    @relation("ProposedResolutions", fields: [proposedById], references: [id])

  @@index([disputeId])
  @@index([proposedById])
  @@index([status])
  @@map("dispute_resolutions")
}

model DisputeInternalNote {
  id        String   @id @default(uuid())
  disputeId String
  authorId  String
  note      String
  createdAt DateTime @default(now())

  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([disputeId])
  @@index([authorId])
  @@map("dispute_internal_notes")
}

model ContractAmendment {
  id                   String          @id @default(uuid())
  amendmentNumber      String          @unique
  contractId           String
  proposedById         String
  status               AmendmentStatus @default(PENDING_REVIEW)
  proposedVersion      Int
  titleChange          String?
  descriptionChange    String?
  scopeChange          String?
  amountChangeMinor    BigInt?
  termsChange          String?
  milestonesSnapshot   Json?
  reason               String
  clientAcceptedAt     DateTime?
  workerAcceptedAt     DateTime?
  previousDocumentHash String?
  updatedDocumentHash  String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  contract             Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  proposedBy           User            @relation("ProposedAmendments", fields: [proposedById], references: [id])

  @@index([contractId])
  @@index([proposedById])
  @@index([status])
  @@map("contract_amendments")
}

model ContractTerminationRequest {
  id                      String            @id @default(uuid())
  contractId              String
  initiatedById           String
  status                  TerminationStatus @default(PENDING_REVIEW)
  reason                  String
  proposedSettlementMinor BigInt?
  settlementTerms         String?
  respondedById           String?
  responseReason          String?
  respondedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  contract                Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  initiatedBy             User              @relation("InitiatedTerminations", fields: [initiatedById], references: [id])

  @@index([contractId])
  @@index([initiatedById])
  @@index([status])
  @@map("contract_termination_requests")
}

model EscrowActivity {
  id                      String                 @id @default(uuid())
  escrowRecordId          String
  milestoneId             String?
  actorId                 String?
  operationalState        EscrowOperationalState
  previousState           EscrowOperationalState?
  eventType               String
  description             String
  metadata                Json?
  isLiveFinancialMovement  Boolean                @default(false)
  createdAt               DateTime               @default(now())

  escrowRecord            EscrowRecord           @relation(fields: [escrowRecordId], references: [id], onDelete: Cascade)
  actor                   User?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([escrowRecordId])
  @@index([milestoneId])
  @@index([actorId])
  @@index([operationalState])
  @@map("escrow_activities")
}
