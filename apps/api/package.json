{
  "name": "@trustpay/api",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-port.cjs 5000 && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.24.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/config": "7.10.1",
    "@trustpay/shared": "*",
    "@types/socket.io": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.16.0",
    "prisma": "7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
