NODE_ENV=development
API_PORT=5000
API_HOST=localhost

# Supabase PostgreSQL Connection String (Keep all real credentials in .env only)
# Format 1 (Session Pooler - Recommended for IPv4 / server environments, Port 5432):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
#
# Format 2 (Direct Connection - IPv6 supported networks, Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
#
# Format 3 (Transaction Pooler - Stateless / serverless environments, Port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SUPERADMIN_URL=http://localhost:3002

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# ------------------------------------------------------------------------------
# Cashfree Payment Gateway Configuration (Phase 5 - SANDBOX Only)
# ------------------------------------------------------------------------------
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=
CASHFREE_RETURN_URL=http://localhost:3000/payments/callback?order_id={order_id}
CASHFREE_WEBHOOK_URL=http://localhost:5000/api/v1/webhooks/cashfree

# ------------------------------------------------------------------------------
# Financial Safety Invariants (Phase 5 Mandatory Sandbox Guards)
# ------------------------------------------------------------------------------
PAYMENTS_LIVE_ENABLED=false
ESCROW_LIVE_MOVEMENT_ENABLED=false
PAYOUTS_ENABLED=false

