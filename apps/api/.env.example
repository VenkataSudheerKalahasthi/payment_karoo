# ==============================================================================
# TRUSTPAY ENTERPRISE v2.0 — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Server Port: Supported via PORT (cloud standard) or API_PORT
PORT=5000
API_PORT=5000
API_HOST=0.0.0.0

# Database Connectivity (Supabase PostgreSQL)
# Format: Session Pooler (IPv4 / IPv6, Port 5432 - Recommended for node servers)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Optional Direct URL for CLI migrations if session pooler is used
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Frontend Application URLs (Used for CORS, Clerk Authorized Parties & Redirects)
# Development defaults shown; in production, use your actual public HTTPS domains:
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SUPERADMIN_URL=http://localhost:3002

# Allowed CORS Origins (Comma-separated public origins)
# In production, set to your live HTTPS URLs (e.g., https://app.yourdomain.com,https://admin.yourdomain.com,https://superadmin.yourdomain.com)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Clerk Authentication (Required)
# Development starts with pk_test_/sk_test_; Production starts with pk_live_/sk_live_
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Supabase Storage & Evidence Access (Optional / Production Secrets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_SIGNING_SECRET=

# ==============================================================================
# FINANCIAL SAFETY INVARIANTS (MANDATORY NON-CUSTODIAL GUARDS)
# ==============================================================================
PAYMENTS_LIVE_ENABLED=false
ESCROW_LIVE_MOVEMENT_ENABLED=false
PAYOUTS_ENABLED=false

# Cashfree Payment Gateway (DEFERRED IN PHASE 8 — Keep unconfigured until activated)
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=
CASHFREE_RETURN_URL=http://localhost:3000/payments/callback?order_id={order_id}
CASHFREE_WEBHOOK_URL=http://localhost:5000/api/v1/webhooks/cashfree
